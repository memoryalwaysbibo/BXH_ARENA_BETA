// BXH ARENA Firestore Rules v13.40.3
// 2026-09-17: atomic community-room deletion authorizes its public mirror by immutable owner fields.
// 2026-09-16: redeploy current Beta rules for player community-room creation.
// 2026-09-15: tester management is restricted to the actor's own TEST tournament.
// 2026-09-12: server-only closure, restore, raffle and activity paths.
// 2026-09-11: Blaze deployment stabilization release. Permission scope is
// unchanged from v13.29.0; trusted title/check-in writes remain server-only.
// 2026-09-11: add isolated title/daily-check-in read paths. All awards,
// check-ins, statistics and audit writes are server-only through Cloud Functions.
// 2026-09-11: add isolated tester role, test-only tournament ownership and
// fixed seven-day expiry invariants. Testers cannot write official or ladder data.
// 2026-09-11: v13.28.4 tester sandbox security release, based on the
// v13.28.3 bracket display update.
// 2026-09-11: v13.28.2 atomic referee-assignment Transaction and dual
// server read-back verification. Permission scope unchanged from v13.28.1.
// 2026-09-11: add Court referee assignment metadata protection + safe staffDirectory.
// 2026-09-10: allow active staff to create/publish an official tournament only when
// the private tournament is created by that same staff UID and initially assigned
// exclusively to that UID. Existing-event assignment, delete, role management and
// ladder settlement privileges are NOT broadened.
// v13.19.2：新增 ladderSkippedPlayers；測試／未綁定現場玩家可略過正式天梯，但該略過名單與結算結果同樣受不可覆寫保護。
rules_version = '2';
// v13.19.2 天梯新增：ladderPlayers / ladderSystem / ladderSeasons / ladderTransactions。
// 積分賽事結算的 tournaments ladder* 欄位僅 admin/super_admin 可正式寫入；staff 被明確禁止。
// 新賽季切換僅 super_admin 可更新 ladderSystem 與既有 ladderSeasons。
// ============================================================================
// BXH ARENA — Firestore Security Rules v13.19.2（含天梯系統）
//
// v13.29.8 已於 Firestore Emulator 驗證關閉／恢復保護與角色案例。
// 測試範圍詳見 RELEASE_v13.29.8.md，並非所有歷史規則的完整驗證。
//
// v10 相對 v9 的關鍵變更：
//   1. 移除 users/{uid}/registrationRefs/{code} 獨立文件，改用
//      collectionGroup('registrations') 查詢玩家自己的報名記錄
//      —— 這是為了讓「registration 變動時必須同時證明 tournaments／
//      publicTournaments 也正確變動」這個雙向一致性要求，能落在
//      access-call 預算內，不需要犧牲任何一致性檢查。
//   2. registrations 的 create/update 規則現在雙向驗證：不只驗證自己，
//      還驗證 tournaments/publicTournaments 在同一次交易中確實正確同步
//      變動（getAfter 比對），防止「單獨建立/修改 registration、不動
//      counter」的漏洞。
//   3. users/{uid} 的自我更新分支改為明確欄位白名單，玩家無法再透過
//      修改自己的文件把 role/active 改成任意值。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /onlinePresence/{uid} { allow read, write: if false; }
    match /playerPrivacy/{uid} { allow read, write: if false; }
    match /playerDirectory/{uid} { allow read, write: if false; }

    // ==== 路徑輔助函式 ====
    function tourPath(code) { return /databases/$(database)/documents/tournaments/$(code); }
    function pubPath(code) { return /databases/$(database)/documents/publicTournaments/$(code); }
    function regPath(code, uid) { return /databases/$(database)/documents/tournaments/$(code)/registrations/$(uid); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }

    // ==== 純資料角色判斷（不含 get()）====
    function callWriteValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['callRevision'])
        && (resource.data.get('callRevision',0)==0
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['data'])
          || request.resource.data.data.matches('.*"callRevision":'+string(resource.data.callRevision)+'[,}].*'));
    }
    function callMirrorValid(code) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['callRevision'])
        && (getAfter(tourPath(code)).data.get('callRevision',0)==0
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bracketView'])
          || request.resource.data.bracketView.matches('.*"callRevision":'+string(getAfter(tourPath(code)).data.callRevision)+'[,}].*'));
    }
    function entrySelectionWriteValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entrySelectionRevision'])
        && (resource.data.get('entrySelectionRevision', 0) == 0
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['data'])
          || (request.resource.data.get('entrySelectionWriteRevision', 0) == resource.data.entrySelectionRevision
            && request.resource.data.data.matches('.*"entrySelectionRevision":' + string(resource.data.entrySelectionRevision) + '[,}].*')));
    }
    function preservesTestSource() {
      return resource.data.get('testMode', false) != true ||
        (request.resource.data.testMode == true && request.resource.data.eventAuthority == 'test'
        && request.resource.data.ladderMode == 'general'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['testMode','testLabel','createdBy','createdByRole','ownerUid','testCreatedAt','testExpiresAt','expiresAt']));
    }
    function hasTestIdentity(d) { return d.role == 'tester' || d.get('isTestAccount', false) == true; }
    function isAdminData(actorData) {
      return actorData.active == true && !hasTestIdentity(actorData) && (actorData.role == 'super_admin' || actorData.role == 'admin');
    }
    function isStaffOrAboveData(actorData) {
      return actorData.active == true && !hasTestIdentity(actorData) && (actorData.role == 'super_admin' || actorData.role == 'admin' || actorData.role == 'staff');
    }
    function isTesterData(actorData) {
      return actorData.active == true && hasTestIdentity(actorData);
    }
    function isTesterOwnedTestData(actorData, tournamentData) {
      return isTesterData(actorData)
        && tournamentData.testMode == true
        && tournamentData.testLabel == '（測試）'
        && tournamentData.eventAuthority == 'test'
        && tournamentData.createdBy == request.auth.uid
        && tournamentData.ownerUid == request.auth.uid
        && tournamentData.createdByRole == 'tester'
        && tournamentData.ladderMode == 'general'
        && tournamentData.ladderPointsAwarded != true;
    }
    function validTesterTestCreate(d) {
      return isSignedIn()
        && isTesterData(myProfile())
        && isTesterOwnedTestData(myProfile(), d)
        && d.expiresAt is timestamp
        && d.testExpiresAt is timestamp
        && d.expiresAt == d.testExpiresAt
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm')
        && d.assignedStaffUids is list
        && (d.assignedStaffUids.size() == 0 || (d.assignedStaffUids.size() == 1 && request.auth.uid in d.assignedStaffUids));
    }
    function isAssignedStaffData(actorData, tournamentData) {
      return actorData.active == true && !hasTestIdentity(actorData) && actorData.role == 'staff' &&
        (!('assignedStaffUids' in tournamentData) || tournamentData.assignedStaffUids.size() == 0
         || request.auth.uid in tournamentData.assignedStaffUids);
    }
    function canManageTournamentData(actorData, tournamentData) {
      return isAdminData(actorData) || isTesterOwnedTestData(actorData, tournamentData) || isAssignedStaffData(actorData, tournamentData);
    }
    function isCommunityOwnerData(tournamentData) {
      return request.auth != null
        && tournamentData.eventAuthority == 'community'
        && tournamentData.createdBy == request.auth.uid
        && tournamentData.ownerUid == request.auth.uid;
    }
    function validCommunityInvariant(d) {
      return d.eventAuthority == 'community'
        && d.createdBy == request.auth.uid
        && d.ownerUid == request.auth.uid
        && d.createdByRole == 'player'
        && d.ladderMode == 'general'
        && d.registrationEnabled == false
        && d.ladderPointsAwarded != true;
    }
    function isStaffOfficialCreatorData(d) {
      return isSignedIn()
        && myProfile().active == true
        && !hasTestIdentity(myProfile()) && myProfile().role == 'staff'
        && d.eventAuthority == 'official'
        && d.createdBy == request.auth.uid
        && d.visibility == 'public'
        && ('assignedStaffUids' in d)
        && d.assignedStaffUids.size() == 1
        && request.auth.uid in d.assignedStaffUids
        && d.ladderPointsAwarded != true;
    }

    function isStaffOfficialCreatorExistingData(d) {
      return isSignedIn()
        && myProfile().active == true
        && !hasTestIdentity(myProfile()) && myProfile().role == 'staff'
        && d.eventAuthority == 'official'
        && d.createdBy == request.auth.uid;
    }
    function validRefereeStationConfig(d) {
      return (!('refereeStationAssignments' in d) || d.refereeStationAssignments is map)
        && (!('refereeStationNames' in d) || d.refereeStationNames is map)
        && (!('refereeStationUids' in d) || d.refereeStationUids is list)
        && (!('refereeStationRestrictionEnabled' in d) || d.refereeStationRestrictionEnabled is bool)
        && (!('assignedStaffUids' in d) || d.assignedStaffUids is list)
        && (!('refereeStationUids' in d) || !('assignedStaffUids' in d) || d.assignedStaffUids.hasAll(d.refereeStationUids));
    }

    // ==== 既有角色 helper（維持 v13.12.3 慣例，供 users/{uid} 等既有區塊使用）====
    function isSignedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdmin() { return isSignedIn() && myProfile().active == true && !hasTestIdentity(myProfile()) && myProfile().role == 'super_admin'; }
    function isTester() { return isSignedIn() && isTesterData(myProfile()); }
    // Tester writes must use the explicit owned-TEST branch, never the admin branch.
    function isTournamentAdminEquivalent() { return isAdminOrAbove(); }
    function isAdminOrAbove() {
      return isSignedIn() && myProfile().active == true && !hasTestIdentity(myProfile()) &&
        (myProfile().role == 'super_admin' || myProfile().role == 'admin');
    }
    function isStaffOrAbove() {
      return isSignedIn() && myProfile().active == true && !hasTestIdentity(myProfile()) &&
        (myProfile().role == 'super_admin' || myProfile().role == 'admin' || myProfile().role == 'staff');
    }
    function isAssignedStaff(tdata) {
      return isSignedIn() && myProfile().active == true && !hasTestIdentity(myProfile()) && myProfile().role == 'staff' &&
        (!('assignedStaffUids' in tdata) || tdata.assignedStaffUids.size() == 0
         || request.auth.uid in tdata.assignedStaffUids);
    }
    function canManageTournament(tdata) {
      return isTournamentAdminEquivalent() || isAssignedStaff(tdata)
        || (isTester() && isTesterOwnedTestData(myProfile(), tdata));
    }
    function tournamentExistsFor(code) { return exists(tourPath(code)); }
    function tournamentDataFor(code) { return get(tourPath(code)).data; }
    // v13.24.2: atomic community room creation writes tournaments + publicTournaments
    // in the same WriteBatch. publicTournaments create must validate the post-write
    // state, not the pre-write database state.
    function tournamentExistsAfterFor(code) { return existsAfter(tourPath(code)); }
    function tournamentDataAfterFor(code) { return getAfter(tourPath(code)).data; }

    // ==== BXH 天梯 helper ====
    function validLadderTier(points, tier) {
      return (points >= 300 && tier == '傳奇')
        || (points >= 220 && points < 300 && tier == '大師')
        || (points >= 150 && points < 220 && tier == '菁英')
        || (points >= 100 && points < 150 && tier == '鑽石')
        || (points >= 60 && points < 100 && tier == '白金')
        || (points >= 30 && points < 60 && tier == '黃金')
        || (points >= 10 && points < 30 && tier == '白銀')
        || (points >= 0 && points < 10 && tier == '黑鐵');
    }

    // ==== 每個 READ 路徑各自專用的授權 helper ====
    function canReadTournamentPrivate() {
      let actorData = get(userPath(request.auth.uid)).data;
      return isStaffOrAboveData(actorData) || isTesterData(actorData);
    }
    function canReadPublicAsStaff() {
      let actorData = get(userPath(request.auth.uid)).data;
      return isStaffOrAboveData(actorData) || isTesterData(actorData);
    }
    function canManageRegistrationRead(code) {
      let actorData = get(userPath(request.auth.uid)).data;
      let tournamentData = get(tourPath(code)).data;
      return canManageTournamentData(actorData, tournamentData);
    }

    function userDataFor(uid) { return get(userPath(uid)).data; }

    // ==== registration 建立/異動規則（v10：雙向一致性）====
    function registrationCreateValid(code, uid) {
      let userData = userDataFor(uid);
      let tournamentData = get(tourPath(code)).data;
      let tourAfterData = getAfter(tourPath(code)).data;
      let pubAfterData = getAfter(pubPath(code)).data;
      return request.resource.data.keys().hasOnly([
          'uid','tournamentCode','realName','gameId','displayName','nameMode','publicName','phone','email',
          'status','source','childEligibilityConfirmed',
          'createdAt','updatedAt','cancelledAt','promotedAt','cancelledBy','promotedBy'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.tournamentCode == code
        && request.resource.data.realName == userData.realName
        && request.resource.data.gameId is string
        && request.resource.data.displayName is string
        && request.resource.data.nameMode in ['realName','gameId']
        && request.resource.data.publicName == request.resource.data.displayName
        && request.resource.data.phone == userData.phone
        && (
             !('email' in request.resource.data) || request.resource.data.email == null
          || ('email' in request.auth.token && request.resource.data.email == request.auth.token.email)
          || request.resource.data.email == userData.email
           )
        && userData.active == true
        && (
             userData.profileCompleted == true
          || (userData.role in ['super_admin','admin','staff','tester']
              && userData.realName is string && userData.realName.size() > 0
              && userData.phone is string)
           )
        && request.resource.data.source == 'player'
        && request.resource.data.status in ['confirmed','waitlist']
        && request.resource.data.childEligibilityConfirmed == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.cancelledAt == null && request.resource.data.cancelledBy == null
        && request.resource.data.promotedAt == null && request.resource.data.promotedBy == null
        && tournamentData.registrationEnabled == true
        && tournamentData.visibility == 'public'
        && tournamentData.registrationVisibility == 'public'
        && tournamentData.publishedAt != null
        && request.time.toMillis() >= tournamentData.registrationOpenAt
        && request.time.toMillis() < tournamentData.registrationCloseAt
        && tournamentData.eventCancelled != true
        && tournamentData.tournamentPhase == 'waiting'
        && tournamentData.archiveStatus != 'completed'
        && (tournamentData.targetGroup != 'children' || request.resource.data.childEligibilityConfirmed == true)
        && (
             request.resource.data.status == 'confirmed'
             && tournamentData.confirmedCount < tournamentData.capacity
             && tourAfterData.confirmedCount == tournamentData.confirmedCount + 1
             && tourAfterData.waitlistCount == tournamentData.waitlistCount
          || request.resource.data.status == 'waitlist'
             && tournamentData.confirmedCount >= tournamentData.capacity
             && tournamentData.waitlistEnabled == true && tournamentData.waitlistCount < tournamentData.waitlistCapacity
             && tourAfterData.waitlistCount == tournamentData.waitlistCount + 1
             && tourAfterData.confirmedCount == tournamentData.confirmedCount
           )
        && pubAfterData.confirmedCount == tourAfterData.confirmedCount
        && pubAfterData.waitlistCount == tourAfterData.waitlistCount;
    }

    function registrationPlayerCancel(code, uid) {
      let tournamentData = get(tourPath(code)).data;
      let tourAfterData = getAfter(tourPath(code)).data;
      let pubAfterData = getAfter(pubPath(code)).data;
      return request.auth.uid == uid
        && resource.data.status in ['confirmed','waitlist']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && tournamentData.cancellationDeadline != null
        && request.time.toMillis() < tournamentData.cancellationDeadline
        && tournamentData.tournamentPhase == 'waiting'
        && tournamentData.archiveStatus != 'completed'
        && (
             resource.data.status == 'confirmed'
             && tourAfterData.confirmedCount == tournamentData.confirmedCount - 1
             && tourAfterData.waitlistCount == tournamentData.waitlistCount
          || resource.data.status == 'waitlist'
             && tourAfterData.waitlistCount == tournamentData.waitlistCount - 1
             && tourAfterData.confirmedCount == tournamentData.confirmedCount
           )
        && pubAfterData.confirmedCount == tourAfterData.confirmedCount
        && pubAfterData.waitlistCount == tourAfterData.waitlistCount;
    }

    function registrationPlayerReregister(code, uid) {
      let userData = userDataFor(uid);
      let tournamentData = get(tourPath(code)).data;
      let tourAfterData = getAfter(tourPath(code)).data;
      let pubAfterData = getAfter(pubPath(code)).data;
      return request.auth.uid == uid
        && resource.data.status == 'cancelled'
        && request.resource.data.status in ['confirmed','waitlist']
        && request.resource.data.uid == uid
        && request.resource.data.tournamentCode == code
        && userData.active == true
        && (
             userData.profileCompleted == true
          || (userData.role in ['super_admin','admin','staff','tester']
              && userData.realName is string && userData.realName.size() > 0
              && userData.phone is string)
           )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.cancelledAt == null && request.resource.data.cancelledBy == null
        && request.resource.data.promotedAt == null && request.resource.data.promotedBy == null
        && request.resource.data.childEligibilityConfirmed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['status','createdAt','updatedAt','cancelledAt','cancelledBy','promotedAt','promotedBy','childEligibilityConfirmed']
           )
        && tournamentData.registrationEnabled == true
        && tournamentData.visibility == 'public'
        && tournamentData.registrationVisibility == 'public'
        && tournamentData.publishedAt != null
        && request.time.toMillis() >= tournamentData.registrationOpenAt
        && request.time.toMillis() < tournamentData.registrationCloseAt
        && tournamentData.eventCancelled != true
        && tournamentData.tournamentPhase == 'waiting'
        && tournamentData.archiveStatus != 'completed'
        && (
             request.resource.data.status == 'confirmed'
             && tournamentData.confirmedCount < tournamentData.capacity
             && tourAfterData.confirmedCount == tournamentData.confirmedCount + 1
             && tourAfterData.waitlistCount == tournamentData.waitlistCount
          || request.resource.data.status == 'waitlist'
             && tournamentData.confirmedCount >= tournamentData.capacity
             && tournamentData.waitlistEnabled == true && tournamentData.waitlistCount < tournamentData.waitlistCapacity
             && tourAfterData.waitlistCount == tournamentData.waitlistCount + 1
             && tourAfterData.confirmedCount == tournamentData.confirmedCount
           )
        && pubAfterData.confirmedCount == tourAfterData.confirmedCount
        && pubAfterData.waitlistCount == tourAfterData.waitlistCount;
    }

    function registrationStaffPromote(code, uid) {
      let tournamentData = get(tourPath(code)).data;
      let actorData = get(userPath(request.auth.uid)).data;
      let tourAfterData = getAfter(tourPath(code)).data;
      let pubAfterData = getAfter(pubPath(code)).data;
      return canManageTournamentData(actorData, tournamentData)
        && tournamentData.tournamentPhase == 'waiting'
        && tournamentData.archiveStatus != 'completed'
        && resource.data.status == 'waitlist'
        && request.resource.data.status == 'confirmed'
        && tournamentData.confirmedCount < tournamentData.capacity
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','promotedAt','promotedBy','updatedAt'])
        && request.resource.data.promotedBy == request.auth.uid
        && request.resource.data.promotedAt == request.time
        && request.resource.data.updatedAt == request.time
        && tourAfterData.confirmedCount == tournamentData.confirmedCount + 1
        && tourAfterData.waitlistCount == tournamentData.waitlistCount - 1
        && pubAfterData.confirmedCount == tourAfterData.confirmedCount
        && pubAfterData.waitlistCount == tourAfterData.waitlistCount;
    }

    function registrationStaffCancel(code, uid) {
      let tournamentData = get(tourPath(code)).data;
      let actorData = get(userPath(request.auth.uid)).data;
      let tourAfterData = getAfter(tourPath(code)).data;
      let pubAfterData = getAfter(pubPath(code)).data;
      return canManageTournamentData(actorData, tournamentData)
        && tournamentData.tournamentPhase == 'waiting'
        && tournamentData.archiveStatus != 'completed'
        && resource.data.status in ['confirmed','waitlist']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','updatedAt'])
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
             resource.data.status == 'confirmed'
             && tourAfterData.confirmedCount == tournamentData.confirmedCount - 1
             && tourAfterData.waitlistCount == tournamentData.waitlistCount
          || resource.data.status == 'waitlist'
             && tourAfterData.waitlistCount == tournamentData.waitlistCount - 1
             && tourAfterData.confirmedCount == tournamentData.confirmedCount
           )
        && pubAfterData.confirmedCount == tourAfterData.confirmedCount
        && pubAfterData.waitlistCount == tourAfterData.waitlistCount;
    }

    // ==== tournaments counter 一致性驗證（v10：移除 registrationRef 檢查）====
    function playerCounterMutationValid(code, uid) {
      let publicBefore = get(pubPath(code)).data;
      let regAfterExists = existsAfter(regPath(code, uid));
      let regAfterData = regAfterExists ? getAfter(regPath(code, uid)).data : null;
      let pubAfterExists = existsAfter(pubPath(code));
      let pubAfterData = pubAfterExists ? getAfter(pubPath(code)).data : null;
      return publicBefore.confirmedCount == resource.data.confirmedCount
        && publicBefore.waitlistCount == resource.data.waitlistCount
        && regAfterExists && pubAfterExists
        && regAfterData.updatedAt == request.time
        && (
             regAfterData.status == 'confirmed' && request.resource.data.confirmedCount == resource.data.confirmedCount + 1 && request.resource.data.waitlistCount == resource.data.waitlistCount
          || regAfterData.status == 'waitlist' && request.resource.data.waitlistCount == resource.data.waitlistCount + 1 && request.resource.data.confirmedCount == resource.data.confirmedCount
          || regAfterData.status == 'cancelled' && (
                  (request.resource.data.confirmedCount == resource.data.confirmedCount - 1 && request.resource.data.waitlistCount == resource.data.waitlistCount)
               || (request.resource.data.waitlistCount == resource.data.waitlistCount - 1 && request.resource.data.confirmedCount == resource.data.confirmedCount)
             )
           )
        && request.resource.data.confirmedCount >= 0 && request.resource.data.waitlistCount >= 0
        && request.resource.data.confirmedCount <= resource.data.capacity
        && pubAfterData.confirmedCount == request.resource.data.confirmedCount
        && pubAfterData.waitlistCount == request.resource.data.waitlistCount;
    }

    function staffCounterMutationAuthorizedAndValid(code, mutationUid, mutationType) {
      let actorData = get(userPath(request.auth.uid)).data;
      let authorized = canManageTournamentData(actorData, resource.data);
      let publicBefore = get(pubPath(code)).data;
      let regAfterExists = existsAfter(regPath(code, mutationUid));
      let regAfterData = regAfterExists ? getAfter(regPath(code, mutationUid)).data : null;
      let pubAfterExists = existsAfter(pubPath(code));
      let pubAfterData = pubAfterExists ? getAfter(pubPath(code)).data : null;
      return authorized
        && resource.data.tournamentPhase == 'waiting'
        && resource.data.archiveStatus != 'completed'
        && publicBefore.confirmedCount == resource.data.confirmedCount
        && publicBefore.waitlistCount == resource.data.waitlistCount
        && regAfterExists && pubAfterExists
        && regAfterData.updatedAt == request.time
        && (
             mutationType == 'promote' && regAfterData.status == 'confirmed' && regAfterData.promotedBy == request.auth.uid
             && resource.data.confirmedCount < resource.data.capacity
             && request.resource.data.confirmedCount == resource.data.confirmedCount + 1
             && request.resource.data.confirmedCount <= resource.data.capacity
             && request.resource.data.waitlistCount == resource.data.waitlistCount - 1
          || mutationType == 'cancel_confirmed' && regAfterData.status == 'cancelled' && regAfterData.cancelledBy == request.auth.uid
             && request.resource.data.confirmedCount == resource.data.confirmedCount - 1
             && request.resource.data.waitlistCount == resource.data.waitlistCount
          || mutationType == 'cancel_waitlist' && regAfterData.status == 'cancelled' && regAfterData.cancelledBy == request.auth.uid
             && request.resource.data.waitlistCount == resource.data.waitlistCount - 1
             && request.resource.data.confirmedCount == resource.data.confirmedCount
           )
        && request.resource.data.confirmedCount >= 0 && request.resource.data.waitlistCount >= 0
        && pubAfterData.confirmedCount == request.resource.data.confirmedCount
        && pubAfterData.waitlistCount == request.resource.data.waitlistCount;
    }

    function publicCounterMatchesSource(code, claimedConfirmed, claimedWaitlist) {
      let tourAfterExists = existsAfter(tourPath(code));
      let tourAfterData = tourAfterExists ? getAfter(tourPath(code)).data : null;
      return tourAfterExists
        && tourAfterData.confirmedCount == claimedConfirmed
        && tourAfterData.waitlistCount == claimedWaitlist
        && (claimedConfirmed != resource.data.confirmedCount || claimedWaitlist != resource.data.waitlistCount);
    }

    // ==== system/bootstrap（既有，未變更）====
    function bootstrapExists() {
      return exists(/databases/$(database)/documents/system/bootstrap) &&
             get(/databases/$(database)/documents/system/bootstrap).data.superAdminExists == true;
    }
    match /system/bootstrap {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.data.superAdminExists == true
        && !bootstrapExists();
    }

    // ==== users/{uid}（v10：修正自升權漏洞）====
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminOrAbove());

      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && isSignedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
               'uid','email','displayName','realName','nickname','gameId','phone','phoneVerified','birthDate','gender','region','preferredNameMode',
               'realNameVerified','realNameVerifiedAt','realNameVerifiedBy',
               'role','active','provider','profileCompleted','profileCompletedAt','avatarUrl','createdAt','updatedAt','lastLoginAt'
             ])
          && request.resource.data.uid == uid
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.realName is string
          && request.resource.data.nickname is string
          && request.resource.data.gameId is string
          && request.resource.data.phone is string
          && request.resource.data.birthDate is string
          && request.resource.data.gender is string
          && request.resource.data.region is string
          && request.resource.data.preferredNameMode in ['realName','gameId']
          && request.resource.data.realNameVerified == false
          && request.resource.data.realNameVerifiedAt == null
          && request.resource.data.realNameVerifiedBy == null
          && request.resource.data.provider is string
          && request.resource.data.role in ['player','tester']
          && request.resource.data.active == true
          && request.resource.data.phoneVerified == false
          && request.resource.data.profileCompleted == true
          && (!('profileCompletedAt' in request.resource.data) || request.resource.data.profileCompletedAt == request.time)
        )
        || (
          request.resource.data.keys().hasOnly(['displayName','email','role','active','createdAt','lastLoginAt'])
          && request.resource.data.displayName is string
          && request.resource.data.email is string
          && request.resource.data.active == true
          && (
               (request.auth.uid == uid && request.resource.data.role == 'super_admin' && !bootstrapExists())
                || (isSuperAdmin() && request.auth.uid != uid && request.resource.data.role == 'admin')
                || (isSuperAdmin() && request.auth.uid != uid && request.resource.data.role == 'tester')
                || (isAdminOrAbove() && request.auth.uid != uid && request.resource.data.role == 'staff')
          )
        )
      );

      // v10 修正：移除原本「request.auth.uid==uid 就放行任何欄位」的裸分支，
      // 改為明確白名單——玩家自我更新完全無法觸碰 role/active/uid/email/
      // provider/phoneVerified/createdAt。
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','active','isTestAccount','managementNote','managementUpdatedAt','managementUpdatedBy']) && (isSuperAdmin()
        || (isAdminOrAbove() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || (
             request.auth.uid == uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                  ['displayName','realName','nickname','gameId','phone','birthDate','gender','region','preferredNameMode',
                   'realNameVerified','realNameVerifiedAt','realNameVerifiedBy','profileCompleted','profileCompletedAt','avatarUrl','updatedAt','lastLoginAt']
                )
             && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileCompletedAt'])
                  || (
                       !('profileCompletedAt' in resource.data)
                       && request.resource.data.profileCompletedAt == request.time
                       && request.resource.data.profileCompleted == true
                     )
                )
             && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['realName'])
                  || (
                       request.resource.data.realNameVerified == false
                       && request.resource.data.realNameVerifiedAt == null
                       && request.resource.data.realNameVerifiedBy == null
                     )
                )
             && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['realNameVerified','realNameVerifiedAt','realNameVerifiedBy'])
                  || (
                       request.resource.data.realNameVerified == false
                       && request.resource.data.realNameVerifiedAt == null
                       && request.resource.data.realNameVerifiedBy == null
                     )
                )
           ));

      allow delete: if false;
    }

    // ==== v13.29.0 玩家稱號／每日簽到 ====
    // 所有 create/update/delete 均由 Cloud Functions 的 Admin SDK 執行；
    // 瀏覽器端只有最小必要讀取權，不能偽造簽到、進度或已取得稱號。
    match /systemSettings/engagement {
      allow read: if true;
      allow write: if false;
    }

    match /publicTitleCatalog/{titleId} {
      allow read: if true;
      allow write: if false;
    }

    match /titleDefinitions/{titleId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /users/{uid}/earnedTitles/{titleId} {
      allow get, list: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update, delete: if false;
    }

    match /users/{uid}/titleProgress/{titleId} {
      allow get, list: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update, delete: if false;
    }

    match /users/{uid}/dailyCheckIns/{dateKey} {
      allow get, list: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update, delete: if false;
    }

    match /playerStats/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminOrAbove());
      allow write: if false;
    }

    match /playerEventResults/{eventPlayerId} {
      allow read: if isAdminOrAbove()
        || (isSignedIn() && resource.data.playerUid == request.auth.uid);
      allow write: if false;
    }

    match /pioneerAwardRuns/{id} { allow read, write: if false; }

    match /titleCounters/{titleId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /titleAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /titleAwardJobs/{jobId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /titleBackfillRuns/{runId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /engagementDailyStats/{dateKey} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ==== 1. tournaments/{code} 完整規則 ====

    // v13.29.8: system-close state is server-owned, including for super_admin clients.
    function operationsUnlocked(d) { return !('systemClosed' in d) || d.systemClosed != true; }
    function noOperationsCreate(d) { return !d.keys().hasAny(['systemClosed','systemClosure','entrySelectionRevision','callRevision']); }
    function completedRoomExpiryValid() { return resource.data.get('eventAuthority','') != 'community' || resource.data.get('archiveStatus','') != 'completed' || request.resource.data.get('expiresAt',null) == null; }
    function noOperationsChange() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['systemClosed','systemClosure','registrationSelection','registeredCount']); }
    function lotteryRuntimeWritable() { return !('registrationSelection' in resource.data) || (!(resource.data.registrationSelection.status in ['drawing','deleting']) && request.resource.data.get('capacity',null) == resource.data.get('capacity',null)); }
    function legacyRegistrationWritable(code) { return !('registrationSelection' in get(/databases/$(database)/documents/tournaments/$(code)).data); }
    function tournamentOperationsUnlocked(code) { return operationsUnlocked(get(/databases/$(database)/documents/tournaments/$(code)).data); }
    match /tournamentActivity/{code} { allow read, write: if false; }
    match /systemSettings/accountManagementControl { allow read, write: if false; }
    match /accountManagementOperations/{id} { allow read, write: if false; }
    match /systemSettings/tournamentOperations { allow read, write: if false; }
    match /tournaments/{code} {
      allow get: if isSignedIn() && (canReadTournamentPrivate() || isCommunityOwnerData(resource.data) || (isTester() && isTesterOwnedTestData(myProfile(), resource.data)));
      allow list: if isSignedIn() && (canReadTournamentPrivate() || isCommunityOwnerData(resource.data) || (isTester() && isTesterOwnedTestData(myProfile(), resource.data)));
      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && noOperationsCreate(request.resource.data) && (
isTournamentAdminEquivalent() || isStaffOfficialCreatorData(request.resource.data) || validTesterTestCreate(request.resource.data) || (isSignedIn() && myProfile().get('active', true) == true && validCommunityInvariant(request.resource.data))
        );
      allow delete: if operationsUnlocked(resource.data) && (
isAdminOrAbove() || (isSignedIn() && isCommunityOwnerData(resource.data)) || (isTester() && isTesterOwnedTestData(myProfile(), resource.data))
        );

      allow update: if
        lotteryRuntimeWritable() && completedRoomExpiryValid() && operationsUnlocked(resource.data) && noOperationsChange() && preservesTestSource() && entrySelectionWriteValid() && callWriteValid() && (
(
          isTournamentAdminEquivalent()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
               ['confirmedCount','waitlistCount','lastRegistrationMutationUid','lastRegistrationMutationType']
             )
          // Once an event's ladder award is committed, its settlement marker/results are immutable.
          // This prevents stale admin clients or ordinary tournament saves from turning true back to false.
          && !(
               ('ladderPointsAwarded' in resource.data && resource.data.ladderPointsAwarded == true)
               && request.resource.data.diff(resource.data).affectedKeys().hasAny(
                    ['ladderPointsAwarded','ladderSeasonId','ladderResults','ladderSkippedPlayers','ladderAwardedAt','ladderAwardedBy']
                  )
             )
        )
        ||
        (
          isAssignedStaff(resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
               ['assignedStaffUids','refereeStationAssignments','refereeStationNames','refereeStationUids','refereeStationRestrictionEnabled','visibility','createdBy','createdByName',
                'confirmedCount','waitlistCount','lastRegistrationMutationUid','lastRegistrationMutationType',
                'ladderPointsAwarded','ladderSeasonId','ladderResults','ladderSkippedPlayers','ladderAwardedAt','ladderAwardedBy']
             )
        )
        ||
        (
          isStaffOfficialCreatorExistingData(resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.eventAuthority == 'official'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'data','updatedAt','entrySelectionWriteRevision','assignedStaffUids','refereeStationAssignments','refereeStationNames','refereeStationUids','refereeStationRestrictionEnabled'
             ])
          && request.auth.uid in request.resource.data.assignedStaffUids
          && validRefereeStationConfig(request.resource.data)
        )
        ||
        (
          isSignedIn()
          && isCommunityOwnerData(resource.data)
          && validCommunityInvariant(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.eventAuthority == resource.data.eventAuthority
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'ladderPointsAwarded','ladderSeasonId','ladderResults','ladderSkippedPlayers','ladderAwardedAt','ladderAwardedBy',
               'confirmedCount','waitlistCount','assignedStaffUids'
             ])
        )
        ||
        (
          isTester()
          && isTesterOwnedTestData(myProfile(), resource.data)
          && isTesterOwnedTestData(myProfile(), request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.eventAuthority == resource.data.eventAuthority
          && request.resource.data.testMode == resource.data.testMode
          && request.resource.data.testLabel == resource.data.testLabel
          && request.resource.data.testCreatedAt == resource.data.testCreatedAt
          && request.resource.data.testExpiresAt == resource.data.testExpiresAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.assignedStaffUids is list
          && (request.resource.data.assignedStaffUids.size() == 0 || (request.resource.data.assignedStaffUids.size() == 1 && request.auth.uid in request.resource.data.assignedStaffUids))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'ladderPointsAwarded','ladderSeasonId','ladderResults','ladderSkippedPlayers','ladderAwardedAt','ladderAwardedBy',
               'confirmedCount','waitlistCount','createdBy','ownerUid','createdByRole','eventAuthority','testMode','testLabel','testCreatedAt','testExpiresAt','expiresAt','ladderMode'
             ])
        )
        ||
        (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount','waitlistCount','updatedAt'])
          && playerCounterMutationValid(code, request.auth.uid)
        )
        ||
        (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['confirmedCount','waitlistCount','updatedAt','lastRegistrationMutationUid','lastRegistrationMutationType']
             )
          && staffCounterMutationAuthorizedAndValid(code, request.resource.data.lastRegistrationMutationUid, request.resource.data.lastRegistrationMutationType)
        )
        );

      match /entrySelection/{id} { allow read, write: if false; }
      match /entryOperations/{id} { allow read, write: if false; }
      match /raffles/{id} { allow read, write: if false; }
      match /raffleControl/{id} { allow read, write: if false; }
      match /operationLog/{id} { allow read, write: if false; }
      match /participants/{playerId} {
        allow read: if isStaffOrAbove() || isTester() || isCommunityOwnerData(get(/databases/$(database)/documents/tournaments/$(code)).data);
        allow write: if tournamentOperationsUnlocked(code) && (
canManageTournament(get(/databases/$(database)/documents/tournaments/$(code)).data) || isCommunityOwnerData(get(/databases/$(database)/documents/tournaments/$(code)).data)
        );
      }

      // ==== 2. tournaments/{code}/registrations/{uid} 完整規則 ====
      match /registrations/{uid} {
        allow get: if isSignedIn() && (request.auth.uid == uid || canManageRegistrationRead(code));
        allow list: if canManageRegistrationRead(code);

        allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && legacyRegistrationWritable(code) && tournamentOperationsUnlocked(code) && (
isSignedIn() && request.auth.uid == uid && registrationCreateValid(code, uid)
        );

        allow update: if legacyRegistrationWritable(code) && tournamentOperationsUnlocked(code) && (
isSignedIn() && (
          registrationPlayerCancel(code, uid)
          || registrationPlayerReregister(code, uid)
          || registrationStaffPromote(code, uid)
          || registrationStaffCancel(code, uid)
        )
        );

        // v13.14.3: 整場賽事刪除時，管理員必須能清除此賽事的報名子集合。
        allow delete: if legacyRegistrationWritable(code) && tournamentOperationsUnlocked(code) && (
isAdminOrAbove() || (isSignedIn() && tournamentExistsFor(code) && (isCommunityOwnerData(tournamentDataFor(code)) || (isTester() && isTesterOwnedTestData(myProfile(), tournamentDataFor(code)))))
        );
      }
    }

    // v10 新增：collection-group 查詢規則，取代 registrationRefs
    // v11 修正：原本用路徑變數 {uid} 比對 request.auth.uid==uid，但玩家
    // 實際查詢是 where("uid","==",currentUid)（依「欄位」過濾，不是依
    // 路徑/文件ID）。Firestore 對 list 查詢的規則驗證，是檢查「查詢本身
    // 是否能證明每一筆結果都符合規則」——查詢用 where 限制的是 uid 欄位，
    // 規則就必須也檢查 resource.data.uid，兩者才能對得上，Firestore 才能
    // 不需要真的執行查詢就證明結果必然合法。改用 resource.data.uid 比對，
    // 並改用 allow list（不是 allow read，避免覆蓋到單筆 get 的既有規則）。
    match /{path=**}/registrations/{registrationId} {
      allow list: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ==== 工作人員個人執勤紀錄 ====
    match /staffActivityLogs/{uid}/matches/{logId} {
      allow get, list: if isSignedIn() && (request.auth.uid == uid || isAdminOrAbove());
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && myProfile().active == true
        && !hasTestIdentity(myProfile()) && myProfile().role in ['staff','admin','super_admin']
        && request.resource.data.uid == uid
        && request.resource.data.tournamentCode is string
        && request.resource.data.matchId is string
        && request.resource.data.confirmedAt is number
        && request.resource.data.keys().hasOnly(['uid','tournamentCode','tournamentName','matchId','station','roundLabel','playerA','playerB','winnerName','resultMethod','confirmedAt','eventAuthority']);
      allow delete: if isSuperAdmin();
    }

    // ==== BXH 天梯系統 ====
    // 正式天梯資料完全以 Firestore 為唯一真實來源，不依賴 localStorage。
    match /ladderPlayers/{uid} {
      allow read: if true;

      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && isAdminOrAbove()
        && request.resource.data.uid == uid
        && request.resource.data.seasonPoints is number
        && request.resource.data.seasonPoints >= 0
        && request.resource.data.careerPoints is number
        && request.resource.data.careerPoints >= 0
        && request.resource.data.rankTier is string
        && validLadderTier(request.resource.data.seasonPoints, request.resource.data.rankTier)
        && request.resource.data.currentSeason is string
        && request.resource.data.highestRankTier is string
        && request.resource.data.totalEvents is number
        && request.resource.data.championCount is number
        && request.resource.data.runnerUpCount is number
        && request.resource.data.thirdPlaceCount is number
        && request.resource.data.fourthPlaceCount is number;

      allow update: if isAdminOrAbove()
        && request.resource.data.uid == uid
        && request.resource.data.seasonPoints is number
        && request.resource.data.seasonPoints >= 0
        && request.resource.data.careerPoints is number
        && request.resource.data.careerPoints >= 0
        && request.resource.data.rankTier is string
        && validLadderTier(request.resource.data.seasonPoints, request.resource.data.rankTier)
        && request.resource.data.currentSeason is string
        && request.resource.data.highestRankTier is string
        && request.resource.data.totalEvents is number
        && request.resource.data.totalEvents >= 0
        && request.resource.data.championCount is number
        && request.resource.data.runnerUpCount is number
        && request.resource.data.thirdPlaceCount is number
        && request.resource.data.fourthPlaceCount is number;

      allow delete: if isSuperAdmin();
    }

    match /ladderSystem/{docId} {
      allow read: if true;
      // 第一次初始化 S1 可由 admin/super_admin 完成；既有天梯控制資料只有最高管理員可改。
      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && docId == 'current' && isAdminOrAbove();
      allow update, delete: if docId == 'current' && isSuperAdmin();
    }

    match /ladderSeasons/{seasonId} {
      allow read: if true;
      // 初次 S1 建立允許 admin；後續賽季切換只允許 super_admin。
      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && isAdminOrAbove();
      allow update, delete: if isSuperAdmin();
    }

    match /ladderTransactions/{logId} {
      allow get: if isAdminOrAbove()
        || (isSignedIn() && resource.data.playerUid == request.auth.uid);
      allow list: if isAdminOrAbove()
        || (isSignedIn() && resource.data.playerUid == request.auth.uid);
      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && (request.resource.data.type != 'event' || ('eventCode' in request.resource.data && tournamentOperationsUnlocked(request.resource.data.eventCode))) && (
isAdminOrAbove()
        && request.resource.data.type in ['event','adjustment']
        && request.resource.data.playerUid is string
        && request.resource.data.playerName is string
        && request.resource.data.seasonId is string
        && request.resource.data.delta is number
        && (!('wins' in request.resource.data) || (request.resource.data.wins is number && request.resource.data.wins >= 0))
        && (!('losses' in request.resource.data) || (request.resource.data.losses is number && request.resource.data.losses >= 0))
        );
      allow update, delete: if false;
    }

    // ==== 隔離式測試天梯：永不與正式 ladder* 集合共用 ====
    match /testLadderPlayers/{testPlayerKey} {
      allow read: if isTester() || isAdminOrAbove();
      allow create, update: if isTester()
        && testPlayerKey.matches('^T[0-9]{3}$')
        && request.resource.data.testPlayerKey == testPlayerKey
        && request.resource.data.playerName is string
        && request.resource.data.seasonId == 'TEST-S1'
        && request.resource.data.seasonPoints is number && request.resource.data.seasonPoints >= 0
        && request.resource.data.careerPoints is number && request.resource.data.careerPoints >= 0
        && request.resource.data.totalEvents is number && request.resource.data.totalEvents >= 0;
      allow delete: if isSuperAdmin();
    }

    match /testLadderTransactions/{logId} {
      allow get, list: if isTester() || isAdminOrAbove();
      allow create: if isTester()
        && request.resource.data.type == 'event'
        && request.resource.data.eventAuthority == 'test'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.eventCode is string
        && tournamentExistsFor(request.resource.data.eventCode)
        && isTesterOwnedTestData(myProfile(), tournamentDataFor(request.resource.data.eventCode))
        && logId == request.resource.data.eventCode + '_' + request.resource.data.testPlayerKey
        && request.resource.data.testPlayerKey.matches('^T[0-9]{3}$')
        && request.resource.data.seasonId == 'TEST-S1'
        && request.resource.data.delta is number && request.resource.data.delta >= 0;
      allow update, delete: if false;
    }

    // ==== publicPlayers/{uid} 公開玩家資料 ====
    // 僅保存公開顯示名稱與頭像；不得包含 email、電話、角色、權限、積分等私人/敏感資料。
    match /publicPlayers/{uid} {
      allow read: if true;

      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['publicName','avatarUrl','updatedAt'])
        && request.resource.data.publicName is string
        && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string)
        && request.resource.data.updatedAt is number;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicName','avatarUrl','updatedAt'])
        && request.resource.data.publicName is string
        && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string)
        && request.resource.data.updatedAt is number;

      allow delete: if isAdminOrAbove();
    }

    // ==== 玩家一般賽事主辦紀錄（僅本人可讀；建立時必須有對應已完成 community 房）====
    match /hostStats/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; allow write: if false; }
    match /hostCompletionLedger/{code} { allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid; allow write: if false; }
    match /hostAwardQueue/{uid} { allow read, write: if false; }
    match /communityHistories/{uid}/events/{eventId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.eventAuthority == 'community'
        && exists(/databases/$(database)/documents/tournaments/$(eventId))
        && get(/databases/$(database)/documents/tournaments/$(eventId)).data.eventAuthority == 'community'
        && get(/databases/$(database)/documents/tournaments/$(eventId)).data.createdBy == uid
        && get(/databases/$(database)/documents/tournaments/$(eventId)).data.archiveStatus == 'completed';
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }


    // ==== v13.28.0 safe referee directory ====
    match /staffDirectory/{uid} {
      allow get, list: if isStaffOrAbove() || isTester();
      allow create, update: if isAdminOrAbove()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && myProfile().active == true
          && myProfile().role in ['staff','admin','super_admin','tester']
          && request.resource.data.keys().hasOnly(['uid','displayName','role','active','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == myProfile().role
          && request.resource.data.active == true
          && request.resource.data.displayName is string
          && request.resource.data.updatedAt is number
        );
      allow delete: if isAdminOrAbove() || (isSignedIn() && request.auth.uid == uid);
    }

    // ==== 3. publicTournaments/{code} 完整規則 ====
    match /publicTournaments/{code} {
      allow get: if !exists(/databases/$(database)/documents/publicTournaments/$(code))
                   || resource.data.visibility == 'public'
                   || canReadPublicAsStaff();
      allow list: if resource.data.visibility == 'public'
                   || canReadPublicAsStaff();

      // v13.40.3: community 公開鏡像以自身不可偽造的 owner 欄位授權刪除。
      // 不再讀取同一 batch 內也會被刪除的 tournaments 文件，避免合法房主遭 permission-denied。
      allow delete: if operationsUnlocked(resource.data) && (
isAdminOrAbove()
        || (
          isSignedIn()
          && resource.data.eventAuthority == 'community'
          && resource.data.ownerUid == request.auth.uid
        )
        || (isTester() && tournamentExistsFor(code) && isTesterOwnedTestData(myProfile(), tournamentDataFor(code)))
        );

      allow create: if !request.resource.data.keys().hasAny(['registrationSelection','registeredCount']) && noOperationsCreate(request.resource.data) && tournamentExistsAfterFor(code) && (
(
        isTournamentAdminEquivalent()
        && tournamentExistsAfterFor(code)
        && request.resource.data.keys().hasOnly([
             'bracketView','updatedAt','visibility',
             'registrationEnabled','registrationOpenAt','registrationCloseAt','registrationStatus',
             'capacity','waitlistEnabled','waitlistCapacity','confirmedCount','waitlistCount',
             'registrationVisibility','publishedAt','eventDate','checkInAt','startAt','fee','timezone',
             'tournamentPhase','location','formatType','name','ladderMode','targetGroup','participantNameMode','eventCancelled','cancellationDeadline','eventDescription','registrationNotes','eventAuthority','ownerUid','hostName','lastActivityAt','expiresAt',
             'testMode','testLabel','createdByRole','testCreatedAt','testExpiresAt'
           ])
        && request.resource.data.bracketView is string
        && request.resource.data.visibility is string
        && request.resource.data.updatedAt is number
        && request.resource.data.confirmedCount == 0
        && request.resource.data.waitlistCount == 0
        && (!('ladderMode' in request.resource.data) || request.resource.data.ladderMode in ['general','ranked'])
        && (!('targetGroup' in request.resource.data) || request.resource.data.targetGroup in ['open','children'])
        && (!('participantNameMode' in request.resource.data) || request.resource.data.participantNameMode in ['realName','gameId'])
      ) || (
        isSignedIn()
        && tournamentExistsAfterFor(code)
        && isStaffOfficialCreatorData(tournamentDataAfterFor(code))
        && request.resource.data.eventAuthority == 'official'
        && request.resource.data.bracketView is string
        && request.resource.data.visibility == 'public'
        && request.resource.data.updatedAt is number
        && request.resource.data.confirmedCount == 0
        && request.resource.data.waitlistCount == 0
        && (!('ladderMode' in request.resource.data) || request.resource.data.ladderMode in ['general','ranked'])
        && (!('targetGroup' in request.resource.data) || request.resource.data.targetGroup in ['open','children'])
        && (!('participantNameMode' in request.resource.data) || request.resource.data.participantNameMode in ['realName','gameId'])
      ) || (
        isSignedIn() && tournamentExistsAfterFor(code) && isCommunityOwnerData(tournamentDataAfterFor(code))
        && request.resource.data.eventAuthority == 'community'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ladderMode == 'general'
        && request.resource.data.registrationEnabled == false
        && request.resource.data.bracketView is string
        && request.resource.data.updatedAt is number
        && request.resource.data.expiresAt is timestamp
      ) || (
        isTester() && tournamentExistsAfterFor(code)
        && isTesterOwnedTestData(myProfile(), tournamentDataAfterFor(code))
        && request.resource.data.keys().hasOnly([
             'bracketView','updatedAt','visibility','registrationEnabled','registrationOpenAt','registrationCloseAt','registrationStatus',
             'capacity','waitlistEnabled','waitlistCapacity','confirmedCount','waitlistCount','registrationVisibility','publishedAt',
             'eventDate','checkInAt','startAt','fee','timezone','tournamentPhase','location','formatType','name','ladderMode','targetGroup',
             'participantNameMode','eventCancelled','cancellationDeadline','eventDescription','registrationNotes','eventAuthority','ownerUid',
             'hostName','expiresAt','testMode','testLabel','createdByRole','testCreatedAt','testExpiresAt'
           ])
        && request.resource.data.testMode == true
        && request.resource.data.testLabel == '（測試）'
        && request.resource.data.eventAuthority == 'test'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdByRole == 'tester'
        && request.resource.data.ladderMode == 'general'
        && request.resource.data.bracketView is string
        && request.resource.data.updatedAt is number
        && request.resource.data.expiresAt == tournamentDataAfterFor(code).expiresAt
        && request.resource.data.testExpiresAt == tournamentDataAfterFor(code).testExpiresAt
      )
        );

      allow update: if
        lotteryRuntimeWritable() && completedRoomExpiryValid() && operationsUnlocked(resource.data) && noOperationsChange() && preservesTestSource() && tournamentOperationsUnlocked(code) && callMirrorValid(code) && (
(
          isTournamentAdminEquivalent()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedCount','waitlistCount'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'bracketView','updatedAt','visibility',
               'registrationEnabled','registrationOpenAt','registrationCloseAt','registrationStatus',
               'capacity','waitlistEnabled','waitlistCapacity','confirmedCount','waitlistCount',
               'registrationVisibility','publishedAt','eventDate','checkInAt','startAt','fee','timezone',
               'tournamentPhase','location','formatType','name','ladderMode','targetGroup','participantNameMode','eventCancelled','cancellationDeadline','eventDescription','registrationNotes','eventAuthority','ownerUid','hostName','lastActivityAt','expiresAt',
               'testMode','testLabel','createdByRole','testCreatedAt','testExpiresAt'
             ])
          && (!('bracketView' in request.resource.data) || request.resource.data.bracketView is string)
          && (!('ladderMode' in request.resource.data) || request.resource.data.ladderMode in ['general','ranked'])
        && (!('targetGroup' in request.resource.data) || request.resource.data.targetGroup in ['open','children'])
        && (!('participantNameMode' in request.resource.data) || request.resource.data.participantNameMode in ['realName','gameId'])
        )
        ||
        (
          tournamentExistsFor(code) && isAssignedStaff(tournamentDataFor(code))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedCount','waitlistCount'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'bracketView','updatedAt',
               'registrationEnabled','registrationOpenAt','registrationCloseAt','registrationStatus',
               'capacity','waitlistEnabled','waitlistCapacity','confirmedCount','waitlistCount',
               'registrationVisibility','publishedAt','eventDate','checkInAt','startAt','fee','timezone',
               'tournamentPhase','location','formatType','name','ladderMode','targetGroup','participantNameMode','eventCancelled','cancellationDeadline','eventDescription','registrationNotes','eventAuthority','ownerUid','hostName','lastActivityAt','expiresAt',
               'testMode','testLabel','createdByRole','testCreatedAt','testExpiresAt'
             ])
          && (!('bracketView' in request.resource.data) || request.resource.data.bracketView is string)
          && (!('ladderMode' in request.resource.data) || request.resource.data.ladderMode in ['general','ranked'])
        && (!('targetGroup' in request.resource.data) || request.resource.data.targetGroup in ['open','children'])
        && (!('participantNameMode' in request.resource.data) || request.resource.data.participantNameMode in ['realName','gameId'])
        )
        ||
        (
          isSignedIn() && tournamentExistsFor(code) && isCommunityOwnerData(tournamentDataFor(code))
          && request.resource.data.eventAuthority == 'community'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ladderMode == 'general'
          && request.resource.data.registrationEnabled == false
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedCount','waitlistCount'])
          && (request.resource.data.expiresAt is timestamp || (request.resource.data.expiresAt == null && tournamentDataAfterFor(code).archiveStatus == 'completed'))
        )
        ||
        (
          isTester() && tournamentExistsFor(code) && isTesterOwnedTestData(myProfile(), tournamentDataFor(code))
          && request.resource.data.testMode == true
          && request.resource.data.testLabel == '（測試）'
          && request.resource.data.eventAuthority == 'test'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdByRole == 'tester'
          && request.resource.data.ladderMode == 'general'
          && request.resource.data.testCreatedAt == resource.data.testCreatedAt
          && request.resource.data.testExpiresAt == resource.data.testExpiresAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.bracketView is string
          && request.resource.data.updatedAt is number
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedCount','waitlistCount','eventAuthority','ownerUid','createdByRole','testMode','testLabel','testCreatedAt','testExpiresAt','expiresAt','ladderMode'])
        )
        ||
        (
          isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bracketView','data','assignedStaffUids'])
          && !('data' in request.resource.data)
          && !('assignedStaffUids' in request.resource.data)
          && (!('bracketView' in request.resource.data) || request.resource.data.bracketView is string)
        )
        ||
        (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount','waitlistCount','updatedAt'])
          && publicCounterMatchesSource(code, request.resource.data.confirmedCount, request.resource.data.waitlistCount)
        )
        );
    }
  }
}
